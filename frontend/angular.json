{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "customer": {
      "projectType": "application",
      "root": "apps/customer",
      "sourceRoot": "apps/customer/src",
      "prefix": "bams",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/customer",
            "index": "apps/customer/src/index.html",
            "browser": "apps/customer/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/customer/tsconfig.app.json",
            "styles": [
              "shared/styles.css"
            ],
            "assets": []
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "customer:build"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "customer:build",
            "tsConfig": "apps/customer/tsconfig.app.json"
          }
        }
      }
    },
    "admin": {
      "projectType": "application",
      "root": "apps/admin",
      "sourceRoot": "apps/admin/src",
      "prefix": "bams",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/admin",
            "index": "apps/admin/src/index.html",
            "browser": "apps/admin/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/admin/tsconfig.app.json",
            "styles": [
              "shared/styles.css"
            ],
            "assets": []
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "admin:build"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "admin:build",
            "tsConfig": "apps/admin/tsconfig.app.json"
          }
        }
      }
    }
  }
}
