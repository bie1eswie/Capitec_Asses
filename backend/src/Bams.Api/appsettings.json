{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "https://api.bams.example",
    "Audience": "bams-api",
    "ActiveKeyId": "",
    "AccessTokenLifetimeMinutes": 15,
    "Keys": []
  },
  "Authentication": {
    "RefreshTokenLifetimeDays": 30,
    "AllowInsecureClientUrl": false
  },
  "Account": {
    "ClientBaseUrl": "http://localhost:4200/"
  },
  "Seed": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
